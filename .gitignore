# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed) — but keep the .example
# templates, which document required vars for new setups and hold no secrets
.env*
!.env*.example

# vercel
.vercel

# android release signing — never commit the real signing key or its passwords
android/**/*.keystore
android/**/*.jks
android/keystore.properties

# android — generated Gradle build output and machine-local SDK path, not
# the native project itself (which is committed, see capacitor.config.ts)
android/build
android/app/build
android/.gradle
android/local.properties
android/captures
android/.externalNativeBuild
android/.cxx
*.apk
*.aab

# local HTTPS certs for `npm run dev:mobile` — machine-specific, regenerate
# per developer, never shared.
/certificates/

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code — local-only settings/state, machine-specific
.claude/settings.local.json
.claude/scheduled_tasks.lock

# stray Windows tool crash dumps
*.stackdump
