# Supabase — required for real authentication (Google sign-in, etc).
# Get these from your Supabase project: Settings > API
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox — required for the interactive map at /map.
# Get a public token (starts with "pk.") from:
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# AdMob — optional. Without these, the app falls back to Google's official
# test ad unit IDs (always serve clearly-labeled test ads, safe for dev).
# Get real IDs from your AdMob account: https://apps.admob.com
# Also set the real Application ID in android/app/src/main/res/values/strings.xml
# (admob_app_id) before shipping a production build. Shown only to users
# without an active subscription — see hooks/use-premium-status.ts.
NEXT_PUBLIC_ADMOB_BANNER_UNIT_ID=
NEXT_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=
NEXT_PUBLIC_ADMOB_REWARDED_UNIT_ID=

# Cakto — required for the "Premium" (remove ads) monthly subscription at
# /billing. CAKTO_* are server-only secrets from your Cakto account;
# NEXT_PUBLIC_CAKTO_OFFER_ID is the public offer/product id used to build
# the checkout link (https://pay.cakto.com.br/<id>).
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
CAKTO_WEBHOOK_SECRET=
NEXT_PUBLIC_CAKTO_OFFER_ID=

# Optional admin tooling for the Cakto integration — narrow secrets, not the
# full Supabase service_role key. See app/api/admin/cakto-offer/route.ts and
# app/api/admin/pending-cancellations/route.ts.
CAKTO_OFFER_ADMIN_SECRET=
ADMIN_REPORT_SECRET=
